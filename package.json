{
  "name": "sastram",
  "description": "discussion and research platform with real-time chat, AI-powered search, and newsletters",
  "version": "0.1.0",
  "license": "MIT",
  "author": "github.com/pulkit777exe",
  "private": true,
  "scripts": {
    "dev": "QSTASH_DEV=true concurrently --kill-others \"npx qstash dev\" \"next dev\"",
    "dev:next": "next dev",
    "dev:qstash": "npx qstash dev",
    "dev:server": "tsx server.ts",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:server": "NODE_ENV=production tsx server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check:prod": "tsx scripts/check-production-readiness.ts",
    "postinstall": "prisma generate",
    "test": "node --import tsx --import tsconfig-paths/register --import ./test/setup.ts ./node_modules/mocha/bin/mocha.js 'test/**/*.test.{mts,ts,tsx,js}'",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate dev && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,jsx}": "eslint --fix",
    "**/*.{json,md,yml,yaml,css,html}": "prettier --write"
  },
  "overrides": {
    "undici": "^8.1.0",
    "minimatch": "^9.0.7",
