# ─── Core (required) ────────────────────────────────────────────────
DATABASE_URL=                              # PostgreSQL connection string (Neon: append ?pgbouncer=true)
DATABASE_URL_UNPOOLED=                     # Neon direct endpoint (no -pooler) for Prisma CLI migrations; derived from DATABASE_URL if unset
BETTER_AUTH_SECRET=                        # Auth signing secret (min 32 chars)
BETTER_AUTH_URL=http://localhost:3000      # Auth base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000" # Public app URL

# ─── Email (Resend, required) ───────────────────────────────────────
RESEND_API_KEY=                            # Resend API key
RESEND_FROM="Sastram <noreply@sastram.wtfpulkit.dev>" # From address
RESEND_TEMPLATE_OTP=                       # Resend template id: login OTP
RESEND_TEMPLATE_INVITATION=                # Resend template id: thread invitation
RESEND_TEMPLATE_THREAD_SUMMARY=            # Resend template id: thread summary
RESEND_TEMPLATE_PASSWORD_RESET=            # Resend template id: password reset
RESEND_TEMPLATE_WELCOME=                   # Resend template id: welcome

# ─── Redis / rate limiting (optional; rate limiting degrades without it) ──
UPSTASH_REDIS_REST_URL=                    # Upstash REST URL (rate limit + quotas)
UPSTASH_REDIS_REST_TOKEN=                  # Upstash REST token

# ─── Background jobs (QStash, optional) ─────────────────────────────
QSTASH_URL=                                # QStash base URL
QSTASH_TOKEN=                              # QStash publish token
QSTASH_CURRENT_SIGNING_KEY=                # QStash request-verification key
QSTASH_NEXT_SIGNING_KEY=                   # QStash key rotation
QSTASH_DEV=                                # Set to a URL to run jobs locally instead of publishing

# ─── Scheduled jobs ─────────────────────────────────────────────────
CRON_SECRET=                               # Bearer token for /api/cron/* (min 32 chars)

# ─── AI providers (optional; at least one needed for AI features) ────
AI_PROVIDER=gemini                         # gemini | openai
GEMINI_API_KEY=                            # Google Gemini key
OPENAI_API_KEY=                            # OpenAI key

# ─── AI model overrides (optional; defaults shown) ──────────────────
GEMINI_FLASH_MODEL=gemini-3.6-flash
GEMINI_PRO_MODEL=gemini-2.5-flash
GEMINI_LITE_MODEL=gemini-3.1-flash-lite
GEMINI_SEARCH_MODEL=gemini-3.1-flash-lite
OPENAI_MODEL=gpt-4o

# ─── AI search (optional; server-side fallback keys, user keys win) ──
SASTRAM_EXA_KEY=                           # Exa search key
SASTRAM_TAVILY_KEY=                        # Tavily search key
SASTRAM_GEMINI_KEY=                        # Gemini key for forum-search fallback

# ─── OAuth (optional) ───────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADMIN_ID=
GOOGLE_ADMIN_SECRET=

# ─── Storage (optional) ─────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=                     # Vercel Blob token
BLOB_URL=                                  # Blob storage origin; URLs under it pass image validation

# ─── Feature flags ──────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true                    # Set false to disable rate limiting
CONTENT_MODERATION_ENABLED=false           # Enable AI image/content moderation
NEXT_PUBLIC_VIEW_TRANSITIONS_ENABLED=true  # Native View Transitions API on thread + SaiSearch (default-on, progressive enhancement)
CSP_REPORT_ONLY=                           # true to send CSP as Report-Only (default: report-only in dev, enforced in prod)

# ─── Limits & tuning (optional; defaults shown) ─────────────────────
MAX_FILE_UPLOAD_MB=10                      # Max upload size in MB
MAX_MESSAGES_PER_MINUTE=20                 # Per-user message rate limit
MAX_MESSAGES_PER_HOUR=200                  # Per-user message rate limit
AI_ANALYSIS_MESSAGE_LIMIT=200              # Messages pulled per AI analysis run
MODERATION_CONFIDENCE_THRESHOLD=0.7        # 0–1; score above which content is flagged
HOSTNAME=localhost                         # Bind host for the custom server
PORT=3000                                  # Bind port for the custom server

# ─── Observability (optional) ───────────────────────────────────────
SENTRY_DSN=                                # Sentry DSN
SENTRY_ORG=                                # Sentry org (source-map upload)
SENTRY_PROJECT=                            # Sentry project (source-map upload)
SENTRY_AUTH_TOKEN=                         # Sentry auth token (source-map upload; CI/build only)
LOG_LEVEL=info                             # debug | info | warn | error

# ─── Client-only (optional) ─────────────────────────────────────────
