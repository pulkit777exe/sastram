# ─── Core (required) ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL_UNPOOLED=                     # Neon direct endpoint (no -pooler) for Prisma CLI migrations; derived if unset
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Better Auth Infra (dash + sentinel server plugins)
BETTER_AUTH_API_KEY=
BETTER_AUTH_API_URL=
BETTER_AUTH_KV_URL=
BETTER_AUTH_IDENTIFY_URL=
NEXT_PUBLIC_BETTER_AUTH_IDENTIFY_URL=

# ─── Email (Resend, required) ───────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM="Sastram <noreply@example.com>"
RESEND_TEMPLATE_OTP=
RESEND_TEMPLATE_INVITATION=
RESEND_TEMPLATE_THREAD_SUMMARY=
RESEND_TEMPLATE_PASSWORD_RESET=
RESEND_TEMPLATE_WELCOME=

# ─── Redis / rate limiting (required in production) ────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Background jobs (QStash) ───────────────────────────────────────
# Local/dev: QSTASH_DEV=true runs jobs inline (no QStash publish/signing needed).
# Production: QSTASH_DEV=false is required; configure URL/token/signing keys together.
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_DEV=true
QSTASH_DAILY_CAP=450

# ─── Scheduled jobs ─────────────────────────────────────────────────
CRON_SECRET=replace-with-a-random-secret-at-least-32-characters

# ─── AI providers ───────────────────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# ─── AI model overrides (optional) ──────────────────────────────────
GEMINI_FLASH_MODEL=gemini-3.6-flash
GEMINI_PRO_MODEL=gemini-2.5-flash
GEMINI_LITE_MODEL=gemini-3.1-flash-lite
GEMINI_SEARCH_MODEL=gemini-3.1-flash-lite
OPENAI_MODEL=gpt-4o

# ─── AI search (optional; server fallback keys) ─────────────────────
SASTRAM_EXA_KEY=
SASTRAM_TAVILY_KEY=
SASTRAM_GEMINI_KEY=

# ─── OAuth (optional) ───────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Storage (optional) ─────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=
BLOB_URL=

# ─── Sentry / observability (optional) ──────────────────────────────
# Runtime DSNs: set SENTRY_DSN (server/edge) and NEXT_PUBLIC_SENTRY_DSN (browser; build-time).
# Release/sourcemap upload (build-time, CI only): SENTRY_AUTH_TOKEN + SENTRY_ORG + SENTRY_PROJECT.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── Feature flags & limits (optional) ──────────────────────────────
RATE_LIMIT_ENABLED=true
QUERY_WARMING_ENABLED=false
CONTENT_MODERATION_ENABLED=
NEXT_PUBLIC_VIEW_TRANSITIONS_ENABLED=true
CSP_REPORT_ONLY=
MAX_FILE_UPLOAD_MB=10
MAX_MESSAGES_PER_MINUTE=20
